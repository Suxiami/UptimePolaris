{
  "schema": 2,
  "id": "polaris-simple",
  "short": "polaris-simple",
  "name": "Polaris Simple",
  "version": "0.2.0",
  "description": "A minimal status and machine dashboard.",
  "themes": [
    {
      "id": "monitor",
      "name": "Polaris Simple · Monitor",
      "target": "monitor",
      "entry": "monitor.html",
      "capabilities": [
        "public.config",
        "public.status"
      ],
      "options": [
        {
          "key": "accent",
          "label": "Accent color / 强调色",
          "type": "color",
          "default": "#386be8"
        },
        {
          "key": "radius",
          "label": "Corner radius (px) / 圆角（像素）",
          "type": "number",
          "default": 18,
          "min": 0,
          "max": 32,
          "step": 1
        },
        {
          "key": "width",
          "label": "Page width (px) / 页面宽度（像素）",
          "type": "number",
          "default": 1000,
          "min": 720,
          "max": 1920,
          "step": 1
        },
        {
          "key": "density",
          "label": "Content density / 内容密度",
          "type": "select",
          "default": "normal",
          "choices": [
            "compact",
            "normal",
            "comfortable"
          ]
        },
        {
          "key": "showMetrics",
          "label": "Show metrics / 显示指标",
          "type": "boolean",
          "default": true
        }
      ]
    },
    {
      "id": "agent",
      "name": "Polaris Simple · Machines",
      "target": "agent",
      "entry": "agent.html",
      "capabilities": [
        "public.config",
        "public.servers"
      ],
      "options": [
        {
          "key": "accent",
          "label": "Accent color / 强调色",
          "type": "color",
          "default": "#386be8"
        },
        {
          "key": "radius",
          "label": "Corner radius (px) / 圆角（像素）",
          "type": "number",
          "default": 18,
          "min": 0,
          "max": 32,
          "step": 1
        },
        {
          "key": "width",
          "label": "Page width (px) / 页面宽度（像素）",
          "type": "number",
          "default": 1000,
          "min": 720,
          "max": 1920,
          "step": 1
        },
        {
          "key": "density",
          "label": "Content density / 内容密度",
          "type": "select",
          "default": "normal",
          "choices": [
            "compact",
            "normal",
            "comfortable"
          ]
        },
        {
          "key": "showMetrics",
          "label": "Show metrics / 显示指标",
          "type": "boolean",
          "default": true
        }
      ]
    }
  ]
}
